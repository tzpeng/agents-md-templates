#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# sync-agents — 用 agents-md-sync 刷新全局(Codex) 和各仓库的 AGENTS.md
#
# 用法:
#   sync-agents                        # 同步下方 REPOS 里列出的所有目标
#   sync-agents --check                # 只检查漂移，不写文件（CI 门禁）
#   sync-agents /path/to/extra-repo    # 额外追加一个仓库（可多次）
#
# 可用环境变量覆盖默认值:
#   AGENTS_TEMPLATE_DIR   模板目录（默认 ~/agents-md-templates）
#   AGENTS_PROFILE        要用的 profile（默认 ROB006）
# =============================================================================

usage() {
  sed -n '4,10p' "$0" | sed 's/^# \{0,1\}//'
}

TEMPLATE_DIR="${AGENTS_TEMPLATE_DIR:-$HOME/agents-md-templates}"
PROFILE="${AGENTS_PROFILE:-ROB006}"
GLOBAL_REPO="$HOME/.codex"

# 默认要同步的仓库列表，追加即可。
REPOS=(
  "$GLOBAL_REPO"
  "$HOME/workspaces/anycloud39av200"
)

CHECK=0
EXTRA_REPOS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check) CHECK=1 ;;
    --template-dir) TEMPLATE_DIR="${2:?--template-dir 需要参数}"; shift ;;
    --profile)      PROFILE="${2:?--profile 需要参数}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) EXTRA_REPOS+=("$1") ;;
  esac
  shift
done

ARGS=(--template-dir "$TEMPLATE_DIR" --profile "$PROFILE")
[[ $CHECK -eq 1 ]] && ARGS+=(--check)

ALL_REPOS=("${REPOS[@]}" "${EXTRA_REPOS[@]}")

fail=0
for repo in "${ALL_REPOS[@]}"; do
  if [[ ! -d "$repo" ]]; then
    echo "!! 跳过（目录不存在）: $repo" >&2
    fail=1
    continue
  fi
  prefix=""
  [[ $CHECK -eq 1 ]] && prefix="(检查) "
  echo "==> ${prefix}$repo"
  if ! agents-md-sync "${ARGS[@]}" --repo "$repo"; then
    echo "!! 失败: $repo" >&2
    fail=1
  fi
done

if [[ $CHECK -eq 1 ]]; then
  echo "检查完成$([[ $fail -eq 0 ]] && echo '（无漂移）')"
else
  echo "同步完成"
fi
exit $fail
